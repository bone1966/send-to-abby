# Copy to .env for local runs. On Render these are set as service env vars.

# Shared secret Abby sends as the X-App-Secret header on /api/* calls.
APP_SHARED_SECRET=

# Public URL of this deployed service, no trailing slash (e.g. https://send-to-abby.onrender.com)
BASE_URL=

# Keith's mobile — used when a send-link request doesn't specify 'to'.
KEITH_PHONE=

# Twilio — same account as the FirstRing phone line, separate number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19084401981
